[Unit]
Description=0 FOMO public Telegram channel bridge (t.me/s previews -> inbox)
After=network-online.target zerofomo-inbox.service
Wants=network-online.target

[Service]
Type=simple
User=zerofomo
Group=zerofomo
WorkingDirectory=/var/lib/zerofomo-inbox
EnvironmentFile=/etc/zerofomo-inbox.env
Environment=INBOX_URL=http://127.0.0.1:8787
Environment=PYTHONUNBUFFERED=1
Environment=TELEGRAM_PUBLIC_STATE=/var/lib/zerofomo-inbox/.telegram_public.state.json
Environment=TELEGRAM_PUBLIC_FILE=/var/lib/zerofomo-inbox/bridges/telegram_public.json
ExecStart=/usr/bin/python3 /opt/zerofomo-inbox/telegram_public_bridge.py
Restart=always
RestartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zerofomo-inbox

[Install]
WantedBy=multi-user.target
